{
  "manifest_version": 2,
  "name": "Responsive Test Cache Cleaner",
  "version": "1.0.0",
  "description": "Automatically clears the browser cache on a timer (and on every page reload) so responsive/layout testing always reflects the latest files, not stale cached ones.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "browsingData",
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Cache Cleaner"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "responsive-cache-cleaner@mhferdosii.local",
      "strict_min_version": "68.0"
    }
  }
}
