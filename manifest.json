{
  "manifest_version": 3,
  "name": "Responsive Cache Cleaner",
  "version": "2.3.1",
  "description": "Keeps HTTP cache and Cache Storage fresh during responsive and layout testing — timer, navigation hooks, scoped clears, and hard reload.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "browsingData",
    "contextMenus",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Responsive Cache Cleaner"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "clear-now": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clear cache now (no reload)"
    },
    "clear-and-reload": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Clear cache and hard-reload the active tab"
    }
  },
  "minimum_chrome_version": "109",
  "browser_specific_settings": {
    "gecko": {
      "id": "responsive-cache-cleaner@mhferdosii.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
